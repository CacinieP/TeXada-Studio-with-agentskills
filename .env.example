# Copy non-secret defaults to .env, then: set -a; . ./.env; set +a
# Secret placeholders stay commented so sourcing cannot overwrite existing environment values.
# Generate your own value with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# DEMO_TOKEN=
VLM_MODEL=minicpm-v4.7-35b-a3b-q4
# Default local profile: verified 35B-A3B Q4_K_M; 64GB Mac tested.
# 32GB is a planning starting point, not validated; 16GB is not a supported target.
# Both direct WebUI and the local launcher use this loopback endpoint.
# VLM_BASE_URL=http://127.0.0.1:18147/v1
# Optional bearer key, server-side environment only. Unset for an unauthenticated local endpoint.
# VLM_API_KEY=
# MiniCPM single-model profile: scripts/run-minicpm-v47-studio.sh
# It selects MiniCPM-V-4.7-1B and defaults to https://api.modelbest.cn/v1.
# VLM_API_KEY may instead be inherited from TEXADA_OPENAI_API_KEY to share the Math Agent environment.
# on loads the formula Skill into model instructions; off is the comparison mode.
SKILL_MODE=on
# Command on PATH or absolute executable path; do not add command-line flags here.
TECTONIC=tectonic
