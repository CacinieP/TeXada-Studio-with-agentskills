# Copy to .env, replace the empty value, then: set -a; . ./.env; set +a
# Generate your own value with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
DEMO_TOKEN=
# 公式修复模型（优先级最高；设为 ollama list 中的完整标签，例如 MiniCPM 文本模型）
REPAIR_MODEL=texada-minicpm5-1b:baseline
# OCR 输入链路预留（见 roadmap「图像与OCR输入」）：需带 vision 能力的标签，例如
OCR_MODEL=minicpm-ocr:latest
# 兼容旧配置：REPAIR_MODEL 未设置时的回退模型标签
VLM_MODEL=qwen3.8:27b-q4_K_M
# on loads the formula Skill into model instructions; off is the comparison mode.
SKILL_MODE=on
# Command on PATH or absolute executable path; do not add command-line flags here.
TECTONIC=tectonic
